<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Home</title>
</head>

<body>
  <ul>
    <% messages.map((message)=> { %>
      <li>
        <div id=<%=message.id %> class="message_item">
          <p>Posted by: <strong>
              <%= message.author %>
            </strong> at <%= message.added.toDateString() %>:<br>
              ><%= message.title %> -- <%= message.content %>
          </p>
        </div>
      </li>
      <% }) %>
  </ul>
</body>

</html>