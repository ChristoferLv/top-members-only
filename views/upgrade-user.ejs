<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>New Member?</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <%- include("partials/header.ejs") %>
    <div class="login">
      <form action="/user/upgrade-to-member" method="POST">
        <h1>Place your code here</h1>
        <label for="code">
          Code:
        </label>
        <input type="text" id="code" name="code" placeholder="****" required>
        <% if (locals.errors) {%>
          <p class="error">
            <%=errors.msg%>
          </p>
          <% } %>
        <div class="wrap">
          <button type="submit">
            Upgrade
          </button>
        </div>
      </form>
    </div>
</body>

</html>