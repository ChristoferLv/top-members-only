<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Log In</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <%- include("partials/header.ejs") %>
     <% if (locals.errors) {%>
            <script>
               console.log("recebido errors")
            </script>
            <% } %>
        <% if (!locals.user || !locals.user.is_member) {%>
            <script>
                window.location.replace('/');
            </script>
            <% } else { %>
                <div class="login">
                    <form action="/messages/new" method="POST">
                        <h1>Post new message</h1>
                        <label for="title">Message Title</label>
                        <input type="text" name="title" id="title" value="<%=locals.recoveredTitle%>">
                        <% if (locals.errors && errors.title) {%>
                            <p class="error"><%=errors.title%></p>
                            <% } %>

                                <label for="content">Content</label>
                                <input type="text" name="content" id="content" value="<%=locals.recoveredContent%>">
                                <% if (locals.errors && errors.content) {%>
                            <p class="error"><%=errors.content%></p>
                            <% } %>
                                <div class="wrap">
                                    <button type="submit">
                                        Submit
                                    </button>
                                </div>
                    </form>
                </div>
                <%}%>
</body>

</html>