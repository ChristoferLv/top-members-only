<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Home</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <%- include("partials/header.ejs") %>
    <% if (locals.user) {%>
      <h1>WELCOME BACK <%= user.username %>
      </h1>
      <% } %>
        <h1>Board Messages</h1>
        <hr>
        <div class="messages">
          <% messages.map((message)=> { %>
            <div id=<%=message.id %> class="message-card">
              <strong>
                <%= message.title %>
              </strong>
              <p>Posted by: <strong>
                  <% if (locals.user) {%>
                    <%= user.username %>
                      <% }else{ %>
                        <%= "Anonymous" %>
                          <%}%>
                </strong>
              </p>
              <p>At <%= message.added.toDateString() %>
              </p>
              > <%= message.content %>
            </div>

            <% }) %>
        </div>

</body>

</html>